# Read-only Google Sheets connection. Share the source sheet with this service-account email as a viewer or editor.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_RANGE=26y 판촉물 신청!A:N
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
GOOGLE_SHEETS_APPLICANT_NAME=성진욱

# Shared Clerk authentication and CRM Supabase storage
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 처방통계 자동 채우기 — mr-crm의 /api/sheets/collected를 서버에서만 호출한다. 키는 브라우저로 내려가지 않는다.
# SYNC_API_KEY는 mr-crm 배포의 같은 이름 값과 같아야 한다(mr-team-erp·mr-sales-plan도 같은 이름을 쓴다).
# MR_CRM_BASE_URL은 생략하면 https://mr-crm-hq8c.vercel.app 을 쓴다.
MR_CRM_BASE_URL=
SYNC_API_KEY=
